rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================
    // HELPERS
    // ============================
    function adminUid() {
      return 'FVnX1NOVgvavWnwnad75zBsRpBU2';
    }

    function isAdmin() {
      return request.auth != null && request.auth.uid == adminUid();
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ============================
    // CONFIG
    // ============================
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /config/club {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================
    // USUARIOS
    // ============================
    match /usuarios/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid);
      allow update: if isAdmin()
                    || (isOwner(uid)
                        && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['email', 'uid']));
      allow delete: if isAdmin();
    }

    // ============================
    // PROGRESO
    // ============================
    match /progreso/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ============================
    // ACCESOS
    // ============================
    match /accesosEspeciales/{claseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /accesosTema/{temaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================
    // SOLICITUDES
    // ============================
    match /solicitudesAcceso/{docId} {
      allow read: if isAuthenticated()
                  && (isAdmin() || request.auth.uid == resource.data.uid);

      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.tipo in ['clase', 'tema']
                    && request.resource.data.email is string
                    && request.resource.data.claseId is string;

      allow update: if isAdmin();

      allow delete: if isAdmin()
                    || (isAuthenticated()
                        && request.auth.uid == resource.data.uid);
    }

    // ============================
    // NOTIFICACIONES
    // ============================
    match /notificaciones/{docId} {
      allow read: if isAuthenticated()
                  && (isAdmin() || request.auth.uid == resource.data.paraUid);

      allow create: if isAuthenticated()
                    && request.resource.data.paraUid is string
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() < 500
                    && request.resource.data.leida == false
                    && request.resource.data.tipo in [
                        'solicitud_clase',
                        'solicitud_tema',
                        'aprobada',
                        'rechazada',
                        'aprobada_total',
                        'revocada_total'
                       ]
                    && (
                        (!isAdmin() && request.resource.data.paraUid == adminUid())
                        ||
                        (isAdmin() && request.resource.data.paraUid != adminUid())
                    );

      allow update: if isAuthenticated()
                    && (isAdmin() || request.auth.uid == resource.data.paraUid)
                    && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['leida']);

      allow delete: if isAdmin()
                    || (isAuthenticated()
                        && request.auth.uid == resource.data.paraUid);
    }

    // ============================
    // CATCH-ALL
    // ============================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
