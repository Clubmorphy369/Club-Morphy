rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================
    // HELPERS
    // ============================
    function adminUid() {
      return 'FVnX1NOVgvavWnwnad75zBsRpBU2';
    }

    function isAdmin() {
      return request.auth != null && request.auth.uid == adminUid();
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ⭐ NUEVO: helper para validar strings con tamaño máximo
    function isValidString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // ============================
    // CONFIG
    // ============================
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /config/club {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================
    // USUARIOS
    // ============================
    match /usuarios/{uid} {
      allow read: if isAuthenticated();

      // ⭐ MEJORADO: validación de tipos y tamaños al crear
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() < 100
                    && request.resource.data.apellidos is string
                    && request.resource.data.apellidos.size() < 100
                    && request.resource.data.perfilCompletado is bool
                    && request.resource.data.asignadoPorAdmin is bool;

      // ⭐ FIX CRÍTICO: quitado 'uid' y 'asignadoPorAdmin'
      //             de la lista editable por el alumno.
      //             Solo el admin puede tocarlos.
      allow update: if isAdmin()
                    || (isOwner(uid)
                        && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly([
                              'email',
                              'nombre',
                              'apellidos',
                              'perfilCompletado'
                            ])
                        && request.resource.data.email is string
                        && request.resource.data.email.size() < 200
                        && request.resource.data.nombre is string
                        && request.resource.data.nombre.size() < 100
                        && request.resource.data.apellidos is string
                        && request.resource.data.apellidos.size() < 100
                        && request.resource.data.perfilCompletado is bool);

      allow delete: if isAdmin();
    }

    // ============================
    // PROGRESO
    // ============================
    match /progreso/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ============================
    // ACCESOS
    // ============================
    match /accesosEspeciales/{claseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /accesosTema/{temaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================
    // SOLICITUDES
    // ============================
    match /solicitudesAcceso/{docId} {
      allow read: if isAuthenticated()
                  && (isAdmin() || request.auth.uid == resource.data.uid);

      // ⭐ MEJORADO: validación completa de tipos, tamaños y campos
      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.tipo in ['clase', 'tema']
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200
                    && request.resource.data.claseId is string
                    && request.resource.data.claseId.size() < 50
                    && request.resource.data.claseTitulo is string
                    && request.resource.data.claseTitulo.size() < 200
                    && request.resource.data.nombreAlumno is string
                    && request.resource.data.nombreAlumno.size() < 200
                    && (
                        // Si es solicitud de tema, debe traer temaId y temaTitulo
                        (request.resource.data.tipo == 'tema'
                          && request.resource.data.temaId is string
                          && request.resource.data.temaId.size() < 50
                          && request.resource.data.temaTitulo is string
                          && request.resource.data.temaTitulo.size() < 200)
                        ||
                        // Si es de clase, no validamos tema (puede no venir)
                        request.resource.data.tipo == 'clase'
                       );

      allow update: if isAdmin();

      allow delete: if isAdmin()
                    || (isAuthenticated()
                        && request.auth.uid == resource.data.uid);
    }

    // ============================
    // NOTIFICACIONES
    // ============================
    match /notificaciones/{docId} {
      allow read: if isAuthenticated()
                  && (isAdmin() || request.auth.uid == resource.data.paraUid);

      // ⭐ MEJORADO: límites de tamaño explícitos para todos los strings
      allow create: if isAuthenticated()
                    && request.resource.data.paraUid is string
                    && request.resource.data.paraUid.size() < 100
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() > 0
                    && request.resource.data.mensaje.size() < 500
                    && request.resource.data.leida == false
                    && request.resource.data.tipo in [
                        'solicitud_clase',
                        'solicitud_tema',
                        'aprobada',
                        'rechazada',
                        'aprobada_total',
                        'revocada_total'
                       ]
                    && (
                        (!isAdmin() && request.resource.data.paraUid == adminUid())
                        ||
                        (isAdmin() && request.resource.data.paraUid != adminUid())
                    );

      allow update: if isAuthenticated()
                    && (isAdmin() || request.auth.uid == request.resource.data.paraUid)
                    && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['leida'])
                    && request.resource.data.leida is bool;

      allow delete: if isAdmin()
                    || (isAuthenticated()
                        && request.auth.uid == resource.data.paraUid);
    }

    // ============================
    // ELO (preparado para futuro uso)
    // ============================
    match /elo/{uid} {
      allow read: if isAuthenticated() && (isOwner(uid) || isAdmin());
      allow write: if isOwner(uid) || isAdmin();
    }

    // ============================
    // ESTADÍSTICAS (preparado para futuro uso)
    // ============================
    match /estadisticas/{uid} {
      allow read: if isAuthenticated() && (isOwner(uid) || isAdmin());
      allow write: if isOwner(uid) || isAdmin();
    }

    // ============================
    // CATCH-ALL — deny by default
    // ============================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
